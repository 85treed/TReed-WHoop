# WHOOP developer app credentials
# Create an app at https://developer.whoop.com (Developer Dashboard -> Create App)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your WHOOP app.
# For local dev this is usually http://localhost:3000/api/auth/callback
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Random 32+ char secret used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Path to the sqlite file used to store WHOOP OAuth tokens. Optional.
DATABASE_PATH=./data/whoop.db
